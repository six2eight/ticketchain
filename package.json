{
  "name": "ticketchain",
  "version": "0.1.0",
  "private": true,
  "description": "NFT event tickets with fraud-proof QR check-in, backed by a production-style Web3 backend.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "hardhat compile",
    "abi": "tsx scripts/export-abi.ts",
    "chain": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "test:contracts": "hardhat test nodejs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "setup": "npm run compile && npm run abi && prisma generate && prisma migrate deploy",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "dev:all": "concurrently -k -n chain,api -c blue,green \"npm run chain\" \"wait-on tcp:127.0.0.1:8545 && npm run deploy:local && npm run dev\"",
    "seed": "tsx scripts/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test:unit": "vitest run test/unit",
    "postinstall": "prisma generate",
    "test:api": "vitest run test/api",
    "demo": "tsx scripts/demo.ts",
    "test:e2e": "vitest run test/e2e",
    "test": "npm run test:contracts && npm run test:unit && npm run test:api && npm run test:e2e",
    "test:web": "playwright test",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@nomicfoundation/hardhat-viem-assertions": "^3.1.4",
    "@openzeppelin/contracts": "^5.6.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "hardhat": "^3.20.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.4.0",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  }
}
