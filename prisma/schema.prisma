// SQLite now; switch to PostgreSQL by changing `provider` + DATABASE_URL.
// Wei amounts are decimal strings, block numbers BigInt, enums are Strings (values documented).

datasource db {
  provider = "sqlite"
}

generator client {
  provider            = "prisma-client"
  output              = "../src/db/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

model Event {
  id           Int      @id // on-chain eventId
  organizer    String // lowercase address
  name         String
  description  String? // off-chain, set by organizer via API
  venue        String?
  priceWei     String
  resaleCapWei String
  maxSupply    Int
  sold         Int      @default(0)
  startTime    DateTime
  createdBlock BigInt
  tickets      Ticket[]
  staff        Staff[]
  updatedAt    DateTime @updatedAt

  @@index([organizer])
  @@index([startTime])
}

model Ticket {
  tokenId        Int        @id
  eventId        Int
  event          Event      @relation(fields: [eventId], references: [id])
  owner          String
  status         String // VALID | CHECKING_IN | USED
  listedPriceWei String? // null = not listed
  usedAt         DateTime?
  mintedBlock    BigInt
  transfers      Transfer[]

  @@index([owner])
  @@index([eventId, status])
}

model Transfer {
  id       Int     @id @default(autoincrement())
  tokenId  Int
  ticket   Ticket  @relation(fields: [tokenId], references: [tokenId])
  from     String
  to       String
  priceWei String?
  txHash   String
  logIndex Int
  block    BigInt

  @@unique([txHash, logIndex])
  @@index([tokenId])
}

model Staff {
  eventId Int
  wallet  String
  event   Event  @relation(fields: [eventId], references: [id])

  @@id([eventId, wallet])
}

// Raw log store, enables reorg rollback + replay.
// tokenId/eventId are denormalized from args so affected projections can be found quickly.
model ChainEvent {
  id          Int    @id @default(autoincrement())
  blockNumber BigInt
  blockHash   String
  txHash      String
  logIndex    Int
  name        String
  args        String // JSON (bigints as strings)
  tokenId     Int?
  eventId     Int?

  @@unique([txHash, logIndex])
  @@index([blockNumber])
  @@index([tokenId])
  @@index([eventId])
}

model BlockCheckpoint {
  number BigInt @id
  hash   String
}

model IndexerState {
  id               Int     @id @default(1)
  lastIndexedBlock BigInt
  contractAddress  String? // lowercase; a change wipes chain-derived tables and re-indexes
}

model DeviceKey {
  id         Int      @id @default(autoincrement())
  tokenId    Int
  deviceAddr String // ephemeral key address generated by the buyer's app (lowercase)
  ownerAtReg String // owner who signed the delegation (lowercase)
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([tokenId])
}

model UsedQrNonce {
  nonce     String   @id
  expiresAt DateTime // cleanup job deletes expired rows
}

model CheckinAttempt {
  id          Int      @id @default(autoincrement())
  tokenId     Int?
  eventId     Int
  staff       String
  result      String // ACCEPTED | REJECTED
  reason      String? // error code when rejected
  txRequestId Int?
  createdAt   DateTime @default(now())

  @@index([eventId])
}

model TxRequest {
  id             Int      @id @default(autoincrement())
  idempotencyKey String   @unique // e.g. "checkin:42"
  kind           String // CHECKIN
  to             String
  data           String // calldata
  status         String // QUEUED | SUBMITTED | CONFIRMED | REVERTED | FAILED
  nonce          Int?
  attempts       String   @default("[]") // JSON [{hash, maxFeePerGas, maxPriorityFeePerGas, gas, sentAt}]
  lastHash       String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model AuthNonce {
  nonce     String   @id
  expiresAt DateTime
}
